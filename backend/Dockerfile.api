# Build context: repository root.  az acr build -f backend/Dockerfile.api .
FROM node:22-alpine AS web
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npx ng build --configuration production

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src/backend
COPY backend/ ./
RUN dotnet restore src/SqlServerLab.Api/SqlServerLab.Api.csproj --locked-mode \
 && dotnet publish src/SqlServerLab.Api/SqlServerLab.Api.csproj -c Release --no-restore -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app ./
COPY --from=web /src/frontend/dist/sql-server-lab/browser ./wwwroot
ENV ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_RUNNING_IN_CONTAINER=true
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["dotnet", "SqlServerLab.Api.dll"]
