{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ControlDb": {
    "Provider": "Sqlite",
    "ConnectionString": "",
    "MigrateOnStartup": false
  },
  "Infrastructure": {
    "Mode": "Local"
  },
  "Authentication": {
    "Mode": "Entra",
    "Authority": "",
    "Audience": ""
  },
  "LabLimits": {
    "MaxActiveLabsPerUser": 2
  },
  "RateLimiting": {
    "MutationsPerMinute": 30
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
