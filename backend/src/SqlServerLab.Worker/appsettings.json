{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ControlDb": {
    "Provider": "Sqlite",
    "ConnectionString": "",
    "MigrateOnStartup": false
  },
  "Infrastructure": {
    "Mode": "Local"
  },
  "Worker": {
    "PollIntervalMs": 1000,
    "LeaseSeconds": 30,
    "HeartbeatIntervalMs": 10000,
    "OperationPollIntervalMs": 1000,
    "OperationTimeoutMinutes": 45,
    "ExpiryScanSeconds": 30
  }
}
